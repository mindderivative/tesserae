# The app's frame (M52): loaded by app.py with app.load_shell(). The rail
# navigates between screens; `app.run(hot_reload=True)` applies edits live.
top_bar: {title: "${title}"}
navigation:
  items:
    - {screen: Home, icon: home}
    - {screen: Settings, icon: settings}
status_bar: {text: Ready}
