# The app's window (opened by app.py with app.open_view("Window")): its title bar, a rail that navigates, and the
# screens, each a view of its own called with a `route:`. `app.run(hot_reload=True)` applies edits live.
name: Window
widget: Window
title: "${title}"
borderless: ${borderless}
min_width: 480
min_height: 320
style: {width: 960, height: 600, background: surface, flex_direction: horizontal}
title_bar: {title: "${title}", icon: home, buttons: [minimize, maximize, close]}
children:
  - widget: NavigationRailScreens
    name: nav
    items:
      - {label: Main, icon: home, screen: Main}
      - {label: Settings, icon: settings, screen: Settings}
  - widget: Container
    name: screens
    style: {flex: fill}
    children:
      - {widget: Main, name: main, route: "", style: {flex: fill}}
      - {widget: Settings, name: settings, route: settings, style: {flex: fill}}
