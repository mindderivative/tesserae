# The ${name} screen: `${name}_ViewModel.py` holds what it binds and handles.
id: root
kind: Container
style: {flex_direction: vertical, gap: 16, padding: 24, background: surface}
children:
  - id: title
    kind: Text
    text: {content: "${title}", typography_role: headline_small}
    style: {foreground: on_surface}
    a11y: {role: heading, level: 1}
  - id: back
    kind: Rect
    style: {width: 96, height: 40, background: secondary_container, corner_radius: 20, align_items: center, justify_content: center}
    handlers: {on_click: "go_back"}
    a11y: {label: "Back"}
    children:
      - id: back_label
        kind: Text
        text: {content: "Back", typography_role: label_large}
        style: {foreground: on_secondary_container}
