# The ${name} screen: `${name}_ViewModel.py` holds what it shows and handles.
name: ${name}
widget: Container
style: {flex_direction: vertical, gap: 16, padding: 24, background: surface}
children:
  - widget: Text
    name: title
    text: "${title}"
    typography_role: headline_small
    style: {foreground: on_surface}
    a11y: {role: heading, level: 1}
  - {widget: Button, name: back, label: Back, variant: tonal, style: {width: 96}, handlers: {on_click: go_back}}
