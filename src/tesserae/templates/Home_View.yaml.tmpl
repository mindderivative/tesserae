# The Home screen: `Home_ViewModel.py` holds what it binds and handles.
id: root
kind: Container
style: {flex_direction: vertical, gap: 16, padding: 24, background: surface}
children:
  - id: greeting
    kind: Text
    text: {content: "", typography_role: headline_small}
    style: {foreground: on_surface}
    bindings: {text: "{{ state.greeting.get() }}"}  # the app's shared state
    a11y: {role: heading, level: 1}
  - id: count
    kind: Text
    text: {content: "", typography_role: body_large}
    style: {foreground: on_surface_variant}
    bindings: {text: "{{ label.get() }}"}
    a11y: {live: polite}
  - id: button
    kind: Rect
    style: {width: 120, height: 40, background: primary, corner_radius: 20, align_items: center, justify_content: center}
    handlers: {on_click: "increment"}
    a11y: {label: "Click me"}
    children:
      - id: button_label
        kind: Text
        text: {content: "Click me", typography_role: label_large}
        style: {foreground: on_primary}
