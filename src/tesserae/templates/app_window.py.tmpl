#!/usr/bin/env python3
"""${title}: a Tesserae app, made by `tesserae new --window`.

Run it with `python app.py`, or `python app.py <route>` to open on a screen
by its route. The window is `Views/Window_View.yaml`: its title bar, its rail
and its screens, which are `view:` nodes with a `route:`. Add a screen with a
`Name_View.yaml` (and a `Name_ViewModel.py` if it needs one) and a `view:` node.

The project's files are found by name in its folders: `Views/Main_View.yaml`
and `ViewModels/Main_ViewModel.py` are `view: Main`, a component in
`Components/` is `component: Name`, a theme in `Themes/` is
`App(custom_theme="Name")`, and a stylesheet in `Styles/` is
`App(stylesheet="Name")`.
"""

import sys
from pathlib import Path

from tesserae import App, Signal, configure_logging

configure_logging()

HERE = Path(__file__).parent


class AppState:
    """What every screen shares: `self.state` in a ViewModel, `state` in a binding."""

    def __init__(self):
        self.greeting = Signal("Hello from ${title}")


app = App(title="${title}", root=HERE, theme_seed=(0x67, 0x50, 0xA4, 0xFF), state=AppState())

app.load("Window")  # Views/Window_View.yaml: the window, with its screens
app.navigate_to(sys.argv[1] if len(sys.argv) > 1 else "")  # a route, or "" for Main
app.run()
