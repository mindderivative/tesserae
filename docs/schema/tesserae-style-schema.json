{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mindderivative.github.io/tesserae/schema/tesserae-style-schema.json",
  "title": "Tesserae style file",
  "description": "A style file, `*_Style.yaml`: one node's style, shared by the views and rules that name it (`style: row_Style.yaml`).",
  "definitions": {
    "color": {
      "anyOf": [
        {
          "enum": [
            "background",
            "error",
            "error_container",
            "inverse_on_surface",
            "inverse_primary",
            "inverse_surface",
            "on_background",
            "on_error",
            "on_error_container",
            "on_primary",
            "on_primary_container",
            "on_primary_fixed",
            "on_primary_fixed_variant",
            "on_secondary",
            "on_secondary_container",
            "on_secondary_fixed",
            "on_secondary_fixed_variant",
            "on_surface",
            "on_surface_variant",
            "on_tertiary",
            "on_tertiary_container",
            "on_tertiary_fixed",
            "on_tertiary_fixed_variant",
            "outline",
            "outline_variant",
            "primary",
            "primary_container",
            "primary_fixed",
            "primary_fixed_dim",
            "scrim",
            "secondary",
            "secondary_container",
            "secondary_fixed",
            "secondary_fixed_dim",
            "shadow",
            "surface",
            "surface_bright",
            "surface_container",
            "surface_container_high",
            "surface_container_highest",
            "surface_container_low",
            "surface_container_lowest",
            "surface_dim",
            "surface_tint",
            "surface_variant",
            "tertiary",
            "tertiary_container",
            "tertiary_fixed",
            "tertiary_fixed_dim"
          ]
        },
        {
          "type": "string"
        }
      ],
      "description": "A theme role (such as `surface` or `on_primary`), `#RGB`, `#RRGGBB`, `#RRGGBBAA`, `transparent`, a CSS colour name, or a CSS function such as `rgb(...)` or `oklch(...)`."
    },
    "fill": {
      "anyOf": [
        {
          "$ref": "#/definitions/color"
        },
        {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\s*(linear|radial|conic)-gradient\\("
            },
            {
              "type": "object",
              "required": [
                "gradient",
                "stops"
              ],
              "additionalProperties": false,
              "properties": {
                "gradient": {
                  "enum": [
                    "linear",
                    "radial",
                    "sweep"
                  ]
                },
                "stops": {
                  "type": "array",
                  "minItems": 2,
                  "description": "Colours, or `[place, colour]` pairs with places from 0 to 1."
                },
                "angle": {
                  "type": "number",
                  "description": "Degrees: 0 up, 90 right, 180 down."
                },
                "center": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "description": "`[x, y]`, as fractions of the box."
                },
                "radius": {
                  "type": "number"
                },
                "start": {
                  "type": "number"
                }
              }
            }
          ],
          "description": "A CSS-like `linear-gradient(...)`, `radial-gradient(...)` or `conic-gradient(...)` whose stops are theme roles or colours, or a mapping with `gradient: linear|radial|sweep` and `stops`."
        }
      ],
      "description": "A colour (a theme role, a hex or a CSS colour) or a gradient."
    },
    "style": {
      "type": "object",
      "description": "How a node looks and lays out its children.",
      "properties": {
        "align_cells": {
          "enum": [
            "top_left",
            "top",
            "top_right",
            "left",
            "center",
            "right",
            "bottom_left",
            "bottom",
            "bottom_right"
          ],
          "description": "In a grid: where each item sits in its cell. (Grid.)",
          "x-group": "Grid"
        },
        "align_content": {
          "enum": [
            "top_left",
            "top",
            "top_right",
            "left",
            "center",
            "right",
            "bottom_left",
            "bottom",
            "bottom_right"
          ],
          "description": "Where its children sit: `top_left`, `top`, `top_right`, `left`, `center`, `right`, `bottom_left`, `bottom` or `bottom_right`. Not set, they fill the space across the layout. (Alignment.)",
          "x-group": "Alignment"
        },
        "align_self": {
          "enum": [
            "top_left",
            "top",
            "top_right",
            "left",
            "center",
            "right",
            "bottom_left",
            "bottom",
            "bottom_right"
          ],
          "description": "Its own place in its parent, over the parent's `align_content`. (Alignment.)",
          "x-group": "Alignment"
        },
        "align_tracks": {
          "enum": [
            "start",
            "center",
            "end",
            "stretch",
            "between",
            "around",
            "evenly"
          ],
          "description": "In a grid: how the tracks share the room left over. (Grid.)",
          "x-group": "Grid"
        },
        "align_wrapped": {
          "enum": [
            "start",
            "center",
            "end",
            "stretch",
            "between",
            "around",
            "evenly"
          ],
          "description": "With `flex_wrap: wrap`: how the lines share the room left over. (Alignment.)",
          "x-group": "Alignment"
        },
        "aspect_ratio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Width over height: gives the missing side from the one set. (Size and spacing.)",
          "x-group": "Size and spacing"
        },
        "backdrop_blur": {
          "type": "number",
          "minimum": 0,
          "description": "Blurs what is behind it, by this many pixels: with a translucent `background`, a frosted surface. (Paint and effects.)",
          "x-group": "Paint and effects"
        },
        "background": {
          "$ref": "#/definitions/fill",
          "description": "Its fill: a theme role such as `surface`, `#RRGGBB`, any CSS colour, or a gradient such as `linear-gradient(90deg, primary, tertiary)`. (Paint and effects.)",
          "x-group": "Paint and effects"
        },
        "blend_mode": {
          "enum": [
            "normal",
            "multiply",
            "screen",
            "overlay",
            "darken",
            "lighten",
            "color_dodge",
            "color_burn",
            "hard_light",
            "soft_light",
            "difference",
            "exclusion",
            "hue",
            "saturation",
            "color",
            "luminosity"
          ],
          "description": "How it is drawn over what is behind it, as CSS `mix-blend-mode`. (Paint and effects.)",
          "x-group": "Paint and effects"
        },
        "blur": {
          "type": "number",
          "minimum": 0,
          "description": "Blurs the node and what it draws, by this many pixels. (Paint and effects.)",
          "x-group": "Paint and effects"
        },
        "border_color": {
          "$ref": "#/definitions/fill",
          "description": "The colour of its border: a colour or a gradient. (Paint and effects.)",
          "x-group": "Paint and effects"
        },
        "border_width": {
          "type": "number",
          "minimum": 0,
          "description": "The width of its border, in pixels. (Paint and effects.)",
          "x-group": "Paint and effects"
        },
        "clip_children": {
          "type": "boolean",
          "description": "Whether children are cut off at its edge. (Paint and effects.)",
          "x-group": "Paint and effects"
        },
        "column_gap": {
          "type": "number",
          "minimum": 0,
          "description": "Space between columns (defaults to `gap`). (Grid.)",
          "x-group": "Grid"
        },
        "corner_radius": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "enum": [
                "extra_large",
                "extra_small",
                "large",
                "medium",
                "none",
                "small"
              ]
            }
          ],
          "description": "Pixels, or a shape token (`none` to `extra_large`). (Paint and effects.)",
          "x-group": "Paint and effects"
        },
        "cursor": {
          "anyOf": [
            {
              "enum": [
                "default",
                "pointer",
                "text",
                "grab",
                "grabbing",
                "move",
                "not_allowed",
                "wait",
                "progress",
                "crosshair",
                "help",
                "col_resize",
                "row_resize",
                "ew_resize",
                "ns_resize",
                "nesw_resize",
                "nwse_resize",
                "copy",
                "cell",
                "context_menu",
                "zoom_in",
                "zoom_out",
                "all_scroll"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "src"
              ],
              "properties": {
                "src": {
                  "type": "string",
                  "description": "A PNG (or any picture Pillow reads) next to the view."
                },
                "hotspot": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  },
                  "description": "`[x, y]`: the pixel that is the pointer's place."
                }
              }
            }
          ],
          "description": "The pointer over it: a name, or `{src: cursor.png, hotspot: [x, y]}` (a picture next to the view, at most 256 pixels a side; only in a node's own `style:`). (Paint and effects.)",
          "x-group": "Paint and effects"
        },
        "display": {
          "enum": [
            "flex",
            "grid"
          ],
          "description": "`flex` (the default) or `grid`. (Grid.)",
          "x-group": "Grid"
        },
        "elevation": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "enum": [
                "level_0",
                "level_1",
                "level_2",
                "level_3",
                "level_4",
                "level_5"
              ]
            }
          ],
          "description": "A shadow level, 0 to 5. (Paint and effects.)",
          "x-group": "Paint and effects"
        },
        "filter": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "saturate": {
              "type": "number",
              "description": "1 is unchanged, 0 grey, above 1 more vivid."
            },
            "brightness": {
              "type": "number",
              "description": "1 is unchanged, 0 black, above 1 brighter."
            },
            "contrast": {
              "type": "number",
              "description": "1 is unchanged, 0 flat grey, above 1 harder."
            },
            "grayscale": {
              "type": "number",
              "description": "0 is unchanged, 1 fully grey."
            },
            "hue_rotate": {
              "type": "number",
              "description": "Turns the hues, in degrees."
            },
            "invert": {
              "type": "number",
              "description": "0 is unchanged, 1 inverted."
            },
            "sepia": {
              "type": "number",
              "description": "0 is unchanged, 1 fully sepia."
            }
          },
          "description": "Colour filters over it and its children, as in CSS: `{grayscale: 1}`, `{saturate: 0.4, brightness: 0.9}` (`hue_rotate` is in degrees). (Paint and effects.)",
          "x-group": "Paint and effects"
        },
        "flex": {
          "enum": [
            "none",
            "expand_horizontal",
            "expand_vertical",
            "fill"
          ],
          "description": "How it takes room in its parent: `none` (the default) is as big as its content and never squeezed, `expand_horizontal` and `expand_vertical` take the room left over in that direction, `fill` both. (Flex.)",
          "x-group": "Flex"
        },
        "flex_direction": {
          "enum": [
            "horizontal",
            "vertical"
          ],
          "description": "How its children are laid out: `horizontal` (the default) or `vertical`. (Flex.)",
          "x-group": "Flex"
        },
        "flex_wrap": {
          "enum": [
            "no_wrap",
            "wrap"
          ],
          "description": "`wrap` lets children flow onto more lines; `no_wrap` keeps one. (Flex.)",
          "x-group": "Flex"
        },
        "foreground": {
          "$ref": "#/definitions/fill",
          "description": "Its text or glyph colour: a theme role, `#RRGGBB`, any CSS colour, or a gradient. (Paint and effects.)",
          "x-group": "Paint and effects"
        },
        "gap": {
          "type": "number",
          "minimum": 0,
          "description": "Space between its children. (Flex.)",
          "x-group": "Flex"
        },
        "grid_auto_columns": {
          "type": "string",
          "description": "The size of columns the template doesn't name. (Grid.)",
          "x-group": "Grid"
        },
        "grid_auto_flow": {
          "enum": [
            "row",
            "column",
            "row dense",
            "column dense",
            "dense"
          ],
          "description": "How grid children fill the cells. (Grid.)",
          "x-group": "Grid"
        },
        "grid_auto_rows": {
          "type": "string",
          "description": "The size of rows the template doesn't name. (Grid.)",
          "x-group": "Grid"
        },
        "grid_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ],
          "description": "Which grid column it takes: `2`, or `1 / 3`. (Grid.)",
          "x-group": "Grid"
        },
        "grid_row": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ],
          "description": "Which grid row it takes: `2`, or `1 / 3`. (Grid.)",
          "x-group": "Grid"
        },
        "grid_template_columns": {
          "type": "string",
          "description": "The grid's columns, as in CSS: `1fr 2fr 100px`. (Grid.)",
          "x-group": "Grid"
        },
        "grid_template_rows": {
          "type": "string",
          "description": "The grid's rows, as in CSS. (Grid.)",
          "x-group": "Grid"
        },
        "height": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "enum": [
                "auto"
              ]
            },
            {
              "type": "string",
              "pattern": "^-?\\d+(\\.\\d+)?%$"
            }
          ],
          "description": "Pixels, `auto` (its content's size, or stretched), or a percentage of the parent such as `50%`. (Size and spacing.)",
          "x-group": "Size and spacing"
        },
        "margin": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "object",
              "properties": {
                "top": {
                  "type": "number"
                },
                "right": {
                  "type": "number"
                },
                "bottom": {
                  "type": "number"
                },
                "left": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            }
          ],
          "description": "Space outside it: one number, or `{left, right, top, bottom}`. (Size and spacing.)",
          "x-group": "Size and spacing"
        },
        "max_height": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "enum": [
                "auto"
              ]
            },
            {
              "type": "string",
              "pattern": "^-?\\d+(\\.\\d+)?%$"
            }
          ],
          "description": "The most height it can take. (Size and spacing.)",
          "x-group": "Size and spacing"
        },
        "max_width": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "enum": [
                "auto"
              ]
            },
            {
              "type": "string",
              "pattern": "^-?\\d+(\\.\\d+)?%$"
            }
          ],
          "description": "The most width it can take. (Size and spacing.)",
          "x-group": "Size and spacing"
        },
        "min_height": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "enum": [
                "auto"
              ]
            },
            {
              "type": "string",
              "pattern": "^-?\\d+(\\.\\d+)?%$"
            }
          ],
          "description": "The least height it can take. (Size and spacing.)",
          "x-group": "Size and spacing"
        },
        "min_width": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "enum": [
                "auto"
              ]
            },
            {
              "type": "string",
              "pattern": "^-?\\d+(\\.\\d+)?%$"
            }
          ],
          "description": "The least width it can take. (Size and spacing.)",
          "x-group": "Size and spacing"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "From 0 (clear) to 1 (opaque). (Paint and effects.)",
          "x-group": "Paint and effects"
        },
        "padding": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "object",
              "properties": {
                "top": {
                  "type": "number"
                },
                "right": {
                  "type": "number"
                },
                "bottom": {
                  "type": "number"
                },
                "left": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            }
          ],
          "description": "Space inside it: one number, or `{left, right, top, bottom}`. (Size and spacing.)",
          "x-group": "Size and spacing"
        },
        "position": {
          "enum": [
            "relative",
            "absolute"
          ],
          "description": "`absolute` takes it out of the flow and places it at `x` and `y`. (Position.)",
          "x-group": "Position"
        },
        "row_gap": {
          "type": "number",
          "minimum": 0,
          "description": "Space between rows (defaults to `gap`). (Grid.)",
          "x-group": "Grid"
        },
        "spread": {
          "enum": [
            "none",
            "between",
            "around",
            "evenly"
          ],
          "description": "Spreads its children along the layout: `between` (the space goes between them), `around` or `evenly`. (Alignment.)",
          "x-group": "Alignment"
        },
        "sticky": {
          "type": "number",
          "description": "In a scroll view, it sticks this many pixels from the top edge as its siblings scroll past. (Position.)",
          "x-group": "Position"
        },
        "width": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "enum": [
                "auto"
              ]
            },
            {
              "type": "string",
              "pattern": "^-?\\d+(\\.\\d+)?%$"
            }
          ],
          "description": "Pixels, `auto` (its content's size, or stretched), or a percentage of the parent such as `50%`. (Size and spacing.)",
          "x-group": "Size and spacing"
        },
        "x": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "enum": [
                "auto"
              ]
            }
          ],
          "description": "Where an `absolute` node sits from the left. (Position.)",
          "x-group": "Position"
        },
        "y": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "enum": [
                "auto"
              ]
            }
          ],
          "description": "Where an `absolute` node sits from the top. (Position.)",
          "x-group": "Position"
        },
        "z_index": {
          "type": "integer",
          "description": "Stacking order: higher is in front. (Position.)",
          "x-group": "Position"
        },
        "zone": {
          "enum": [
            "left",
            "right",
            "top",
            "bottom",
            "center"
          ],
          "description": "A DockPanel's zone in its Dock: where it docks. Only a DockPanel directly in a Dock has one; anywhere else it is an error. (Docking.)",
          "x-group": "Docking"
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "style"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "A name for the style, such as `row_style`. It is for the reader."
    },
    "style": {
      "$ref": "#/definitions/style",
      "description": "The style fields, as in a node's `style:`."
    }
  }
}
