{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mindderivative.github.io/tesserae/schema/tesserae-theme-schema.json",
  "title": "Tesserae theme or stylesheet",
  "description": "A theme or stylesheet file: `styles:` rules, and for a theme also a `seed`, `dark`, `colors`, `typography` and `components`.",
  "definitions": {
    "parameter": {
      "type": "string",
      "pattern": "^\\s*\\{\\{.*\\}\\}\\s*$",
      "description": "A fragment parameter: filled in where the fragment is used."
    },
    "conditional": {
      "type": "object",
      "required": [
        "if",
        "then"
      ],
      "additionalProperties": false,
      "properties": {
        "if": {},
        "then": {},
        "else": {}
      },
      "description": "A value chosen by a parameter: `{if: \"{{ flag }}\", then: a, else: b}`."
    },
    "color": {
      "anyOf": [
        {
          "enum": [
            "background",
            "error",
            "error_container",
            "inverse_on_surface",
            "inverse_primary",
            "inverse_surface",
            "on_background",
            "on_error",
            "on_error_container",
            "on_primary",
            "on_primary_container",
            "on_primary_fixed",
            "on_primary_fixed_variant",
            "on_secondary",
            "on_secondary_container",
            "on_secondary_fixed",
            "on_secondary_fixed_variant",
            "on_surface",
            "on_surface_variant",
            "on_tertiary",
            "on_tertiary_container",
            "on_tertiary_fixed",
            "on_tertiary_fixed_variant",
            "outline",
            "outline_variant",
            "primary",
            "primary_container",
            "primary_fixed",
            "primary_fixed_dim",
            "scrim",
            "secondary",
            "secondary_container",
            "secondary_fixed",
            "secondary_fixed_dim",
            "shadow",
            "surface",
            "surface_bright",
            "surface_container",
            "surface_container_high",
            "surface_container_highest",
            "surface_container_low",
            "surface_container_lowest",
            "surface_dim",
            "surface_tint",
            "surface_variant",
            "tertiary",
            "tertiary_container",
            "tertiary_fixed",
            "tertiary_fixed_dim"
          ]
        },
        {
          "type": "string"
        }
      ],
      "description": "A theme role (such as `surface` or `on_primary`), `#RGB`, `#RRGGBB`, `#RRGGBBAA`, `transparent`, a CSS colour name, or a CSS function such as `rgb(...)` or `oklch(...)`."
    },
    "style": {
      "type": "object",
      "description": "How a node looks and lays out its children.",
      "properties": {
        "align_content": {
          "anyOf": [
            {
              "enum": [
                "start",
                "end",
                "flex_start",
                "flex_end",
                "center",
                "stretch",
                "space_between",
                "space_around",
                "space_evenly"
              ]
            },
            {
              "$ref": "#/definitions/parameter"
            },
            {
              "$ref": "#/definitions/conditional"
            }
          ],
          "description": "How wrapped rows, or grid tracks, are spaced."
        },
        "align_items": {
          "anyOf": [
            {
              "enum": [
                "start",
                "end",
                "flex_start",
                "flex_end",
                "center",
                "baseline",
                "stretch"
              ]
            },
            {
              "$ref": "#/definitions/parameter"
            },
            {
              "$ref": "#/definitions/conditional"
            }
          ],
          "description": "Where its children sit across the layout axis."
        },
        "align_self": {
          "anyOf": [
            {
              "enum": [
                "start",
                "end",
                "flex_start",
                "flex_end",
                "center",
                "baseline",
                "stretch"
              ]
            },
            {
              "$ref": "#/definitions/parameter"
            },
            {
              "$ref": "#/definitions/conditional"
            }
          ],
          "description": "Overrides its parent's `align_items` for this node."
        },
        "aspect_ratio": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "$ref": "#/definitions/parameter"
            },
            {
              "$ref": "#/definitions/conditional"
            }
          ],
          "description": "Width over height: gives the missing side from the one set."
        },
        "background": {
          "anyOf": [
            {
              "$ref": "#/definitions/color"
            },
            {
              "$ref": "#/definitions/parameter"
            },
            {
              "$ref": "#/definitions/conditional"
            }
          ],
          "description": "Its fill: a theme role such as `surface`, `#RRGGBB`, or any CSS colour."
        },
        "border_color": {
          "anyOf": [
            {
              "$ref": "#/definitions/color"
            },
            {
              "$ref": "#/definitions/parameter"
            },
            {
              "$ref": "#/definitions/conditional"
            }
          ],
          "description": "The colour of its border."
        },
        "border_width": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "$ref": "#/definitions/parameter"
            },
            {
              "$ref": "#/definitions/conditional"
            }
          ],
          "description": "The width of its border, in pixels."
        },
        "clip_children": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/definitions/parameter"
            },
            {
              "$ref": "#/definitions/conditional"
            }
          ],
          "description": "Whether children are cut off at its edge."
        },
        "column_gap": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "$ref": "#/definitions/parameter"
            },
            {
              "$ref": "#/definitions/conditional"
            }
          ],
          "description": "Space between columns (defaults to `gap`)."
        },
        "corner_radius": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "enum": [
                    "extra_large",
                    "extra_small",
                    "large",
                    "medium",
                    "none",
                    "small"
                  ]
                }
              ]
            },
            {
              "$ref": "#/definitions/parameter"
            },
            {
              "$ref": "#/definitions/conditional"
            }
          ],
          "description": "Pixels, or a shape token (`none` to `extra_large`)."
        },
        "display": {
          "anyOf": [
            {
              "enum": [
                "flex",
                "grid"
              ]
            },
            {
              "$ref": "#/definitions/parameter"
            },
            {
              "$ref": "#/definitions/conditional"
            }
          ],
          "description": "`flex` (the default) or `grid`."
        },
        "elevation": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "enum": [
                    "level_0",
                    "level_1",
                    "level_2",
                    "level_3",
                    "level_4",
                    "level_5"
                  ]
                }
              ]
            },
            {
              "$ref": "#/definitions/parameter"
            },
            {
              "$ref": "#/definitions/conditional"
            }
          ],
          "description": "A shadow level, 0 to 5."
        },
        "flex_basis": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "enum": [
                    "auto"
                  ]
                },
                {
                  "type": "string",
                  "pattern": "^-?\\d+(\\.\\d+)?%$"
                }
              ]
            },
            {
              "$ref": "#/definitions/parameter"
            },
            {
              "$ref": "#/definitions/conditional"
            }
          ],
          "description": "Its size along the main axis before it grows or shrinks."
        },
        "flex_direction": {
          "anyOf": [
            {
              "enum": [
                "horizontal",
                "vertical"
              ]
            },
            {
              "$ref": "#/definitions/parameter"
            },
            {
              "$ref": "#/definitions/conditional"
            }
          ],
          "description": "How its children are laid out: `horizontal` (the default) or `vertical`."
        },
        "flex_grow": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "$ref": "#/definitions/parameter"
            },
            {
              "$ref": "#/definitions/conditional"
            }
          ],
          "description": "How much of the spare room it takes, relative to its siblings."
        },
        "flex_shrink": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "$ref": "#/definitions/parameter"
            },
            {
              "$ref": "#/definitions/conditional"
            }
          ],
          "description": "How much it gives up when there is too little room."
        },
        "flex_wrap": {
          "anyOf": [
            {
              "enum": [
                "no_wrap",
                "wrap"
              ]
            },
            {
              "$ref": "#/definitions/parameter"
            },
            {
              "$ref": "#/definitions/conditional"
            }
          ],
          "description": "`wrap` lets children flow onto more lines; `no_wrap` keeps one."
        },
        "foreground": {
          "anyOf": [
            {
              "$ref": "#/definitions/color"
            },
            {
              "$ref": "#/definitions/parameter"
            },
            {
              "$ref": "#/definitions/conditional"
            }
          ],
          "description": "Its text or glyph colour: a theme role, `#RRGGBB`, or any CSS colour."
        },
        "gap": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "$ref": "#/definitions/parameter"
            },
            {
              "$ref": "#/definitions/conditional"
            }
          ],
          "description": "Space between its children."
        },
        "grid_auto_columns": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/definitions/parameter"
            },
            {
              "$ref": "#/definitions/conditional"
            }
          ],
          "description": "The size of columns the template doesn't name."
        },
        "grid_auto_flow": {
          "anyOf": [
            {
              "enum": [
                "row",
                "column",
                "row dense",
                "column dense",
                "dense"
              ]
            },
            {
              "$ref": "#/definitions/parameter"
            },
            {
              "$ref": "#/definitions/conditional"
            }
          ],
          "description": "How grid children fill the cells."
        },
        "grid_auto_rows": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/definitions/parameter"
            },
            {
              "$ref": "#/definitions/conditional"
            }
          ],
          "description": "The size of rows the template doesn't name."
        },
        "grid_column": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            {
              "$ref": "#/definitions/parameter"
            },
            {
              "$ref": "#/definitions/conditional"
            }
          ],
          "description": "Which grid column it takes: `2`, or `1 / 3`."
        },
        "grid_row": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            {
              "$ref": "#/definitions/parameter"
            },
            {
              "$ref": "#/definitions/conditional"
            }
          ],
          "description": "Which grid row it takes: `2`, or `1 / 3`."
        },
        "grid_template_columns": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/definitions/parameter"
            },
            {
              "$ref": "#/definitions/conditional"
            }
          ],
          "description": "The grid's columns, as in CSS: `1fr 2fr 100px`."
        },
        "grid_template_rows": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/definitions/parameter"
            },
            {
              "$ref": "#/definitions/conditional"
            }
          ],
          "description": "The grid's rows, as in CSS."
        },
        "height": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "enum": [
                    "auto"
                  ]
                },
                {
                  "type": "string",
                  "pattern": "^-?\\d+(\\.\\d+)?%$"
                }
              ]
            },
            {
              "$ref": "#/definitions/parameter"
            },
            {
              "$ref": "#/definitions/conditional"
            }
          ],
          "description": "Pixels, `auto` (its content's size, or stretched), or a percentage of the parent such as `50%`."
        },
        "justify_content": {
          "anyOf": [
            {
              "enum": [
                "start",
                "end",
                "flex_start",
                "flex_end",
                "center",
                "stretch",
                "space_between",
                "space_around",
                "space_evenly"
              ]
            },
            {
              "$ref": "#/definitions/parameter"
            },
            {
              "$ref": "#/definitions/conditional"
            }
          ],
          "description": "Where its children sit along the layout axis."
        },
        "justify_items": {
          "anyOf": [
            {
              "enum": [
                "start",
                "end",
                "flex_start",
                "flex_end",
                "center",
                "baseline",
                "stretch"
              ]
            },
            {
              "$ref": "#/definitions/parameter"
            },
            {
              "$ref": "#/definitions/conditional"
            }
          ],
          "description": "Where grid children sit across their cell's width."
        },
        "justify_self": {
          "anyOf": [
            {
              "enum": [
                "start",
                "end",
                "flex_start",
                "flex_end",
                "center",
                "baseline",
                "stretch"
              ]
            },
            {
              "$ref": "#/definitions/parameter"
            },
            {
              "$ref": "#/definitions/conditional"
            }
          ],
          "description": "Where this node sits across its grid cell's width."
        },
        "margin": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "$ref": "#/definitions/parameter"
                    },
                    {
                      "$ref": "#/definitions/conditional"
                    }
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "top": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "$ref": "#/definitions/parameter"
                        },
                        {
                          "$ref": "#/definitions/conditional"
                        }
                      ]
                    },
                    "right": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "$ref": "#/definitions/parameter"
                        },
                        {
                          "$ref": "#/definitions/conditional"
                        }
                      ]
                    },
                    "bottom": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "$ref": "#/definitions/parameter"
                        },
                        {
                          "$ref": "#/definitions/conditional"
                        }
                      ]
                    },
                    "left": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "$ref": "#/definitions/parameter"
                        },
                        {
                          "$ref": "#/definitions/conditional"
                        }
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              ]
            },
            {
              "$ref": "#/definitions/parameter"
            },
            {
              "$ref": "#/definitions/conditional"
            }
          ],
          "description": "Space outside it: one number, or `{left, right, top, bottom}`."
        },
        "max_height": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "enum": [
                    "auto"
                  ]
                },
                {
                  "type": "string",
                  "pattern": "^-?\\d+(\\.\\d+)?%$"
                }
              ]
            },
            {
              "$ref": "#/definitions/parameter"
            },
            {
              "$ref": "#/definitions/conditional"
            }
          ],
          "description": "The most height it can take."
        },
        "max_width": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "enum": [
                    "auto"
                  ]
                },
                {
                  "type": "string",
                  "pattern": "^-?\\d+(\\.\\d+)?%$"
                }
              ]
            },
            {
              "$ref": "#/definitions/parameter"
            },
            {
              "$ref": "#/definitions/conditional"
            }
          ],
          "description": "The most width it can take."
        },
        "min_height": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "enum": [
                    "auto"
                  ]
                },
                {
                  "type": "string",
                  "pattern": "^-?\\d+(\\.\\d+)?%$"
                }
              ]
            },
            {
              "$ref": "#/definitions/parameter"
            },
            {
              "$ref": "#/definitions/conditional"
            }
          ],
          "description": "The least height it can take."
        },
        "min_width": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "enum": [
                    "auto"
                  ]
                },
                {
                  "type": "string",
                  "pattern": "^-?\\d+(\\.\\d+)?%$"
                }
              ]
            },
            {
              "$ref": "#/definitions/parameter"
            },
            {
              "$ref": "#/definitions/conditional"
            }
          ],
          "description": "The least width it can take."
        },
        "opacity": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "$ref": "#/definitions/parameter"
            },
            {
              "$ref": "#/definitions/conditional"
            }
          ],
          "description": "From 0 (clear) to 1 (opaque)."
        },
        "padding": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "$ref": "#/definitions/parameter"
                    },
                    {
                      "$ref": "#/definitions/conditional"
                    }
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "top": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "$ref": "#/definitions/parameter"
                        },
                        {
                          "$ref": "#/definitions/conditional"
                        }
                      ]
                    },
                    "right": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "$ref": "#/definitions/parameter"
                        },
                        {
                          "$ref": "#/definitions/conditional"
                        }
                      ]
                    },
                    "bottom": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "$ref": "#/definitions/parameter"
                        },
                        {
                          "$ref": "#/definitions/conditional"
                        }
                      ]
                    },
                    "left": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "$ref": "#/definitions/parameter"
                        },
                        {
                          "$ref": "#/definitions/conditional"
                        }
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              ]
            },
            {
              "$ref": "#/definitions/parameter"
            },
            {
              "$ref": "#/definitions/conditional"
            }
          ],
          "description": "Space inside it: one number, or `{left, right, top, bottom}`."
        },
        "position": {
          "anyOf": [
            {
              "enum": [
                "relative",
                "absolute"
              ]
            },
            {
              "$ref": "#/definitions/parameter"
            },
            {
              "$ref": "#/definitions/conditional"
            }
          ],
          "description": "`absolute` takes it out of the flow and places it at `x` and `y`."
        },
        "row_gap": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "$ref": "#/definitions/parameter"
            },
            {
              "$ref": "#/definitions/conditional"
            }
          ],
          "description": "Space between rows (defaults to `gap`)."
        },
        "width": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "enum": [
                    "auto"
                  ]
                },
                {
                  "type": "string",
                  "pattern": "^-?\\d+(\\.\\d+)?%$"
                }
              ]
            },
            {
              "$ref": "#/definitions/parameter"
            },
            {
              "$ref": "#/definitions/conditional"
            }
          ],
          "description": "Pixels, `auto` (its content's size, or stretched), or a percentage of the parent such as `50%`."
        },
        "x": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "enum": [
                    "auto"
                  ]
                }
              ]
            },
            {
              "$ref": "#/definitions/parameter"
            },
            {
              "$ref": "#/definitions/conditional"
            }
          ],
          "description": "Where an `absolute` node sits from the left."
        },
        "y": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "enum": [
                    "auto"
                  ]
                }
              ]
            },
            {
              "$ref": "#/definitions/parameter"
            },
            {
              "$ref": "#/definitions/conditional"
            }
          ],
          "description": "Where an `absolute` node sits from the top."
        },
        "z_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "$ref": "#/definitions/parameter"
            },
            {
              "$ref": "#/definitions/conditional"
            }
          ],
          "description": "Stacking order: higher is in front."
        }
      },
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "description": "Styles for the nodes it matches: by `kind`, by `classes`, or by `id`. With none of the three, for every node.",
      "properties": {
        "kind": {
          "enum": [
            "Checkbox",
            "CircularProgress",
            "Container",
            "GraphNode",
            "Icon",
            "Image",
            "LinearProgress",
            "Link",
            "LoadingIndicator",
            "NodeGraph",
            "RadioButton",
            "Rect",
            "ScrollView",
            "Slider",
            "SpinBox",
            "Switch",
            "Text",
            "TextField",
            "TimePickerDial"
          ],
          "description": "Every node of this kind."
        },
        "classes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Nodes with all of these classes."
        },
        "id": {
          "type": "string",
          "description": "The node with this id."
        },
        "style": {
          "$ref": "#/definitions/style"
        }
      },
      "additionalProperties": false
    }
  },
